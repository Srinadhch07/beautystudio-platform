# ---------------------------------------------------------------------------
# Frontend (browser-visible) configuration.
#
# Copy this file to `frontend/.env`. That file is git-ignored.
#
# IMPORTANT: only variables prefixed with `VITE_` are exposed to the browser.
# Never add AWS keys, the JWT secret, SMTP passwords or the MongoDB connection
# string here - those belong to the backend `.env` only.
# ---------------------------------------------------------------------------

# Shown in the document title and the app shell.
VITE_APP_NAME=Beauty Parlour

# Base URL prefixed to every API call.
#
# The backend mounts its API at `<api_prefix>/v1`, so this MUST include the
# version segment - without it every request 404s. Use the relative default with
# the dev proxy below, or an absolute URL such as http://127.0.0.1:8000/api/v1 to
# call the backend cross-origin.
VITE_API_BASE_URL=/api/v1

# --- Development server only (NOT exposed to the browser) ------------------
# Target that `npm run dev` proxies `/api` requests to.
DEV_API_TARGET=http://127.0.0.1:8000
