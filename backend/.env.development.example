# ---------------------------------------------------------------------------
# Local development overrides. Copy to `backend/.env` and adjust.
#
# The repository-root `.env` is production-oriented: `COOKIE_SECURE=true` and
# `COOKIE_SAMESITE=none`, which is correct behind HTTPS but breaks a local
# `http://` setup - the browser silently refuses to store the session cookie and
# every authenticated request 401s with no obvious cause. Values here are read
# after the root `.env` (see `Settings.model_config` in app/core/config.py), so
# only the differences are listed.
#
# The backend logs a warning at start-up when `COOKIE_SECURE=true` is combined
# with an `http://` FRONTEND_URL, and points here.
# ---------------------------------------------------------------------------

# Development runs over plain http, so the session cookie must not be secure.
COOKIE_SECURE=false

# `lax` keeps the browser's own CSRF protection, which is enough for a
# same-site dev setup. The double-submit X-CSRF-Token check is enforced either
# way, so the client behaves identically here and in production.
COOKIE_SAMESITE=lax

# Where the Vite dev server runs. Also used to build password-reset links, so it
# must be set for the reset flow to work locally.
FRONTEND_URL=http://localhost:5173

# Uncomment to talk to a local MongoDB instead of the Atlas instance in the
# root `.env`. Recommended while developing, so a stray write cannot reach
# production data.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=beauty_parlour

# Verbose logging while developing. Secrets are never logged at any level.
LOG_LEVEL=INFO
