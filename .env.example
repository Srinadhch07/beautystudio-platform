# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in the values.
# `.env` is git-ignored and must NEVER be committed.
#
# The backend reads this file automatically (see backend/app/core/config.py).
# Values below are non-functional placeholders unless stated otherwise.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Beauty Parlour
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=WARNING
# URL prefix that every API route is mounted under (health check -> /api/health)
API_PREFIX=/api

# --- MongoDB ---------------------------------------------------------------
# Local: mongodb://localhost:27017
# Production: MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=beauty_parlour
MONGO_TIMEOUT_MS=3000

# --- CORS ------------------------------------------------------------------
# Exact frontend origin(s), comma-separated. NO wildcard "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Authentication / sessions ----------------------------------------------
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# MUST be at least 32 characters; shorter values are rejected at start-up and
# every protected endpoint refuses to issue a token.
JWT_SECRET=iwonttellyou
# Access-token lifetime. Short by design: the token cannot be revoked, so this
# bounds how long a stolen cookie stays useful.
JWT_ACCESS_MINUTES=30
COOKIE_NAME=beauty_parlour
CSRF_COOKIE_NAME=beauty_parlour_csrf
# Set only when the API is served from a domain shared with the frontend.
# Leave empty for local development.
COOKIE_DOMAIN=
# MUST be true in production (HTTPS required). Set to false for local http, or
# the browser will silently refuse to store the session cookie.
COOKIE_SECURE=false
# lax | strict | none  ("none" requires COOKIE_SECURE=true)
# "none" is needed when the frontend and API are on different sites. It removes
# the browser's built-in CSRF protection, so the double-submit X-CSRF-Token
# check becomes mandatory - it is enforced regardless of this setting.
COOKIE_SAMESITE=lax

# --- Password reset ---------------------------------------------------------
# Lifetime of an emailed reset token. Kept short: the token is a bearer
# credential for a full account takeover. Maximum accepted value is 1440.
PASSWORD_RESET_MINUTES=30

# --- Login rate limiting -----------------------------------------------------
# Failed attempts per window, counted against BOTH the client IP and the
# submitted address. 5 / 15 minutes is a starting point, not a tuned value.
#
# This counter lives in the process's memory. It is correct for the current
# single-instance deployment; with N workers or containers the effective limit
# becomes N times this number. A shared store is the fix before scaling out.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Image storage ---------------------------------------------------------
# s3 | local  -- production MUST use s3
# Phase 1 implements s3 only. With STORAGE_MODE=local every upload is refused
# with 503 storage_not_configured rather than silently writing to the bucket, so
# a development machine can never write to the production one by accident.
STORAGE_MODE=s3
# Only used when STORAGE_MODE=local (development fallback)
STORAGE_LOCAL_DIR=storage-local
# Hard ceiling for one uploaded image, enforced while the request body is still
# being read. Uploads above it are refused with 413 payload_too_large.
# Only JPEG, PNG and WebP are accepted, verified by file signature.
PRODUCT_IMAGE_MAX_BYTES=5242880

# --- AWS S3 (backend only - never exposed to the frontend) -----------------
# Used by the server alone. The React application receives only public image
# URLs; it never receives these values and has no code path that could return
# them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=

# --- Email (SMTP) ----------------------------------------------------------
# Plain SMTP. Add username/password only if the provider requires auth.
# Password reset emails are silently skipped (with a server-side log) unless
# SMTP_HOST and SMTP_FROM_EMAIL are both set.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
# Absolute URL of the frontend, used to build links in emails.
# REQUIRED for password reset: the emailed link is
#   <FRONTEND_URL>/admin/reset-password?token=...
# Leaving this empty does not disable the endpoint - it makes every reset email
# impossible to deliver, and the reset flow silently does nothing.
FRONTEND_URL=http://localhost:5173
